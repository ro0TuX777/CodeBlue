# CodeBlue Environment Configuration Example
# Copy this file to .env and modify as needed

# Flask settings
FLASK_ENV=development  # Set to 'production' for production deployment
FLASK_SECRET_KEY=your-secret-key-here  # Change this to a random string in production

# Server settings
CODEBLUE_HOST=0.0.0.0  # Use 0.0.0.0 to listen on all interfaces
CODEBLUE_PORT=5001  # Default port, change if needed

# GitHub API settings
GITHUB_TOKEN=your-github-token-here  # Required for GitHub API access

# TypeSafe API settings
TYPESAFE_API_KEY=your-typesafe-api-key-here  # Required for finding-severity triage on the security issues page

# Logging settings
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
